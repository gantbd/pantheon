{
  "version": 1,
  "name": "Local engine federation",
  "surfaces": [
    "overview",
    "chronos",
    "vellum",
    "agora",
    "moira",
    "daimon",
    "tellus",
    "aegis",
    "hermes",
    "operations",
    "configuration"
  ],
  "agora": {
    "socket": "../run/agora.sock",
    "participant": "operator",
    "requires": ["rooms.read.v2"]
  },
  "moira": {
    "socket": "../run/moira.sock",
    "requires": ["sagas.inspect.v1"]
  },
  "daimon": {
    "socket": "../run/daimon.sock",
    "agent_socket": "../run/daimon-agent.sock",
    "agent_session": "00000000000000000000000000000000",
    "execution": {
      "principal": "10101010101010101010101010101010",
      "profile": "11111111111111111111111111111111",
      "task_attempt": {
        "task_key": "14141414141414141414141414141414",
        "task_incarnation": 1,
        "attempt_number": 1
      },
      "context": [],
      "tools": [],
      "budget": {
        "max_elapsed_millis": 60000,
        "max_input_tokens": 4096,
        "max_output_tokens": 8192,
        "max_tool_calls": 32,
        "max_context_bytes": 1048576,
        "max_output_bytes": 1048576
      }
    },
    "requires": [
      "agents.presence.v1",
      "agents.session.inspect.v1",
      "agents.session-set.prompt.v1",
      "agents.session-set.permission.v1",
      "agents.session-set.reattach.v1"
    ]
  },
  "hermes": {
    "socket": "../run/hermes.sock",
    "requires": ["ledger.observe.v1"]
  },
  "aegis": {
    "socket": "../run/aegis.sock",
    "requires": ["authority.observe.v1"]
  },
  "tellus": {
    "endpoint": "127.0.0.1:4499",
    "token": "../run/dendrite.token",
    "requires": ["tellus.observe.v1"]
  },
  "chronos": {
    "deployment": "attach",
    "workstreams": [
      {
        "name": "Atlas / Delivery",
        "directory": "../state/chronos-atlas"
      }
    ],
    "requires": ["tasks.workflow.observe.v9"],
    "moira": [
      {
        "workstream": "Atlas / Delivery",
        "socket": "../run/moira.sock",
        "scope": "atlas-delivery"
      }
    ],
    "daimon": [
      {
        "workstream": "Atlas / Delivery",
        "socket": "../run/daimon.sock"
      }
    ],
    "planning": null
  },
  "vellum": {
    "deployment": "attach",
    "socket": "../run/vellum.sock",
    "credential": null,
    "roots": [],
    "allow_add_file": false,
    "requires": ["workspace.inventory.v1"]
  }
}
