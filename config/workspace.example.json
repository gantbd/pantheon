{
  "version": 1,
  "name": "Local engine federation",
  "surfaces": [
    "overview",
    "workspace",
    "agora",
    "moira",
    "daimon",
    "grounding",
    "aegis",
    "hermes"
  ],
  "agora": {
    "socket": "../run/agora.sock",
    "participant": "operator",
    "requires": ["rooms.read.v2"]
  },
  "moira": {
    "socket": "../run/moira.sock",
    "requires": ["sagas.inspect.v1"]
  },
  "chronos": {
    "deployment": "attach",
    "workstreams": [
      {
        "name": "Atlas / Delivery",
        "directory": "../state/chronos-atlas"
      }
    ],
    "requires": ["tasks.observe.v1"],
    "moira": [
      {
        "workstream": "Atlas / Delivery",
        "socket": "../run/moira.sock",
        "scope": "atlas-delivery"
      }
    ],
    "daimon": [
      {
        "workstream": "Atlas / Delivery",
        "socket": "../run/daimon.sock"
      }
    ],
    "planning": null
  },
  "vellum": {
    "deployment": "attach",
    "socket": "../run/vellum.sock",
    "credential": null,
    "roots": [],
    "requires": ["workspace.inventory.v1"]
  }
}
