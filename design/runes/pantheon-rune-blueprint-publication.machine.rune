(machine pantheon-rune-blueprint-publication
  (rosetta
    (intent "compose exact question-bound Rune blueprint preparation with the existing human-gated Vellum packet-publication machine without duplicating either owner")
    (values semantic-preservation owner-authority refusal-honesty minimal-composition)
    (outcomes "clarification remains distinct from qualification" "only an owner-complete low-or-moderate projection can enter publication" "the parent advances only after the exact packet-publication child succeeds" "child refusal or unknown settlement cannot become parent success")
    (who "the Pantheon composition host, Rune author boundary, packet-publication owner, Vellum owner, and named human approver")
    (what "the thin parent machine from one exact blueprint through publication settlement")
    (when "a user asks Pantheon to turn reviewed task prose into a publishable Vellum design packet")
    (where "Pantheon's in-memory composition boundary")
    (why "manual file handoff adds deterministic toil while copied publication states would create divergent authority")
    (how "retain exact prose and answers, re-run Rune qualification, apply additive risk admission, then require the existing child machine's exact settlement verdict")
    (extent "one blueprint revision and one invoked packet-publication child; no task mutation, direct Vellum edit, acceptance, go-no-go, or rollout authority")
    (examples "a moderate-risk complete blueprint invokes pantheon-rune-packet-publication and advances only after its durable success" "an unresolved question returns to clarification" "a Gray request refuses before publication"))
  (epistemic-tier bool)
  (initial blueprint-received)

  (state blueprint-received
    (rosetta (intent "retain one exact blueprint and determine whether owner questions remain") (values exact-input non-inference) (outcomes "the exact prose, request digest, declared risk, and question set are retained") (who "Pantheon's blueprint adapter and Rune author") (what "effect-free blueprint admission") (when "before answers or publication preparation") (where "private in-memory composition state") (why "prose cannot be silently promoted into invented semantics") (how "invoke the existing blueprint preparation boundary and retain its typed result") (extent "one request with no publication effect") (examples "Rune returns three typed questions")))
  (state questions-returned
    (rosetta (intent "hold exact typed owner questions until digest-bound answers arrive") (values owner-authority freshness) (outcomes "no candidate or publication is claimed while questions remain") (who "the named owner or human reviewer") (what "clarification state") (when "Rune reports questions_pending") (where "the blueprint response boundary") (why "missing semantics must be asked rather than inferred") (how "return the exact paths, categories, question text, and base request digest") (extent "questions only; no mutation") (examples "the ensemble-fit answer remains pending")))
  (state projection-qualified
    (rosetta (intent "retain the exact complete Rune source, typed IR, Rust projection, lineage, and owner outcome") (values compiler-authority provenance) (outcomes "the blueprint projection is complete without granting publication authority") (who "Rune, Scry, Smith, rustc, and the observing Pantheon adapter") (what "qualified projection evidence") (when "all exact owner questions are resolved") (where "the compiler boundary") (why "valid code generation and permission to publish are separate decisions") (how "accept only the existing closed projection-qualified owner result") (extent "read-only evidence with no Vellum mutation") (examples "Scry and Smith report complete compatibility")))
  (state publication-eligible
    (rosetta (intent "admit only a complete projection allowed by Pantheon's additive publication-risk policy") (values proportionality gray-honesty) (outcomes "low or moderate eligible work may prepare publication; high and Gray cannot") (who "Pantheon's additive risk policy under the named sponsor") (what "publication admission") (when "after exact projection qualification") (where "the boundary before child invocation") (why "compiler success cannot erase risk-specific owner contracts") (how "require the typed eligible result rather than caller text") (extent "admission only; no approval or edit") (examples "moderate with dissent recorded is eligible")))
  (state durable-published
    (rosetta (intent "record that the exact existing child machine settled durable publication successfully") (values durable-truth no-laundering) (outcomes "the parent reports success for the same blueprint and child lineage") (who "the packet-publication owner, Vellum owner, and observing Pantheon host") (what "terminal composed success") (when "only after exact child Succeeded settlement") (where "the composition result boundary") (why "parent success must preserve the child's full approval, edit, and persistence law") (how "advance only from the generated invoked-machine verdict") (extent "one result; no acceptance, go-no-go, or rollout") (examples "Vellum durable save is observed for the approved minimal patch")))
  (state refused
    (rosetta (intent "retain an actionable upstream refusal without entering publication") (values honesty least-authority) (outcomes "the named missing question, owner contract, risk admission, or projection obligation remains visible") (who "the blueprint or additive risk owner") (what "terminal pre-publication refusal") (when "qualification or risk admission fails") (where "before child invocation") (why "non-eligibility is not child failure and must not be hidden as generic absence") (how "return the typed existing refusal and its bounded orientation") (extent "no retry, publication, or mutation") (examples "Gray lacks its named experiment contract")))

  (edge (from blueprint-received) (to questions-returned) (emit clarification-required)
    (precondition "the existing blueprint adapter returns questions_pending with one or more exact typed questions and no candidate, typed IR, projection, or publication eligibility")
    (rosetta (intent "surface unresolved semantics") (values non-inference) (outcomes "the owner receives exact questions") (who "Pantheon and the semantic owner") (what "clarification motion") (when "questions remain") (where "blueprint boundary") (why "unknown meaning cannot advance") (how "retain the exact closed result") (extent "one response") (examples "machine topology is unresolved")))
  (edge (from questions-returned) (to blueprint-received) (emit answers-bound)
    (precondition "answers match every exact question path, category, text, and the current base request digest; a fresh blueprint preparation is required")
    (rosetta (intent "bind owner answers without mutating stale requests") (values freshness exactness) (outcomes "the revised request is re-evaluated from the beginning") (who "the owner and blueprint adapter") (what "question-bound revision") (when "complete answers arrive") (where "in-memory request AST") (why "answers to an older digest grant no authority") (how "apply the existing deterministic revision operation then re-run preparation") (extent "one fresh preparation") (examples "the sponsor's ensemble answer binds the exact request")))
  (edge (from blueprint-received) (to projection-qualified) (emit projection-admitted)
    (precondition "the existing blueprint adapter returns projection_qualified with no remaining questions, exact source/IR/projection lineage, complete compatibility, and no inferred owner answer")
    (rosetta (intent "admit exact compiler evidence") (values provenance completeness) (outcomes "risk admission may be evaluated") (who "Rune, Scry, Smith, rustc, and Pantheon") (what "qualification motion") (when "the owner request is complete") (where "compiler result boundary") (why "publication must start from the exact qualified projection") (how "retain the typed owner result without reconstruction") (extent "one projection") (examples "the canonical machine and Rust projection share lineage")))
  (edge (from projection-qualified) (to publication-eligible) (emit risk-admitted)
    (precondition "Pantheon's additive policy returns the typed eligible_for_separate_human_approved_vellum_patch result for this exact complete low-or-moderate projection")
    (rosetta (intent "admit proportionate publication preparation") (values proportionality) (outcomes "the existing publication child may be settled") (who "Pantheon's risk policy") (what "risk-admission motion") (when "qualification is complete") (where "before publication") (why "eligibility must not be inferred from compiler success") (how "match the closed typed eligibility value") (extent "admission only") (examples "moderate risk with explicit dissent")))
  (edge (from projection-qualified) (to refused) (emit publication-refused)
    (precondition "the exact projection is high or Gray, lacks its named owner contract, or otherwise is not typed eligible for separate human-approved Vellum publication")
    (rosetta (intent "stop before publication when additive risk law is unmet") (values gray-honesty least-authority) (outcomes "the actionable missing contract is retained") (who "Pantheon's risk policy and named owner") (what "risk refusal motion") (when "publication is not eligible") (where "before child invocation") (why "high and Gray cannot borrow moderate-risk authority") (how "preserve the existing typed refusal") (extent "terminal refusal") (examples "Gray needs an admitted experiment boundary")))
  (edge (from publication-eligible) (to durable-published) (invoke pantheon-rune-packet-publication) (emit blueprint-published)
    (precondition "the invoked child identity and its recomputed blueprint, packet, target, patch, approval, edit, persistence, and lineage evidence all refer to this exact request")
    (rosetta (intent "bind parent completion to the existing child's exact durable success") (values holofractal-law refusal-absorption) (outcomes "Succeeded advances; Refused and Unknown remain parent refusals") (who "Smith's generated settlement boundary and the packet-publication owner") (what "one-level invoked-machine bind") (when "publication eligibility is exact and current") (where "Pantheon's composition runtime") (why "copying the child's states or treating dispatch as settlement would weaken the law") (how "supply the exact child descriptor to a bounded settlement adapter and accept only Succeeded") (extent "one child lookup; no recursive execution or implicit retry") (examples "durable child success advances" "unknown edit outcome cannot advance")))

  (signal clarification-required (rosetta (intent "announce exact owner questions") (values orientation) (outcomes "the user knows what blocks progress") (who "the owner") (what "clarification output") (when "questions remain") (where "composition boundary") (why "refusal should be actionable") (how "emit after question retention") (extent "one signal") (examples "clarification required")))
  (signal answers-bound (rosetta (intent "announce fresh answer binding") (values traceability) (outcomes "preparation restarts") (who "the owner") (what "revision output") (when "answers match") (where "composition boundary") (why "freshness is observable") (how "emit before re-entry") (extent "one signal") (examples "answers bound")))
  (signal projection-admitted (rosetta (intent "announce qualified projection evidence") (values provenance) (outcomes "risk review begins") (who "the operator") (what "qualification output") (when "projection completes") (where "composition boundary") (why "qualification and publication differ") (how "emit exact admission") (extent "one signal") (examples "projection admitted")))
  (signal risk-admitted (rosetta (intent "announce typed publication eligibility") (values proportionality) (outcomes "child settlement may be queried") (who "the operator") (what "risk output") (when "policy admits") (where "composition boundary") (why "risk authority remains explicit") (how "emit after typed match") (extent "one signal") (examples "risk admitted")))
  (signal publication-refused (rosetta (intent "announce actionable pre-publication refusal") (values honesty) (outcomes "no child is invoked") (who "the operator") (what "refusal output") (when "risk law is unmet") (where "composition boundary") (why "blocked work needs orientation") (how "emit typed refusal") (extent "one signal") (examples "publication refused")))
  (signal blueprint-published (rosetta (intent "announce exact composed durable success") (values durable-truth) (outcomes "the operator can join parent and child lineage") (who "the operator and observers") (what "success output") (when "the child settles Succeeded") (where "composition boundary") (why "success must remain attributable") (how "emit after generated invocation settlement") (extent "one signal") (examples "blueprint published"))))
