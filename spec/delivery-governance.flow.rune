(flow delivery-governance
  (boundary shared-methods (label "Shared Rune method corpus"))
  (boundary tellus-boundary (label "Tellus grounded-context boundary"))
  (boundary owner-services (label "Sovereign owner services"))
  (boundary composition (label "Pantheon composition boundary"))
  (boundary human-authority (label "Named human authority"))
  (node rune store (label "Validated Rune methods") (in shared-methods)
    (attr authority "authored method and structural proof"))
  (node dendrite process (label "Dendrite corpus projection") (in tellus-boundary)
    (attr authority "bounded grounding and provenance"))
  (node tellus process (label "Tellus typed presentation") (in tellus-boundary)
    (attr authority "present grounded methods and provenance without mutation authority"))
  (node definition-owner process (label "Sovereign review definition owner not yet selected") (in owner-services)
    (attr status "human architecture decision required"))
  (node vellum store (label "Vellum review artifacts") (in owner-services)
    (attr authority "documents and revisions, not approval"))
  (node chronos process (label "Chronos work and agenda facts") (in owner-services)
    (attr authority "admitted work, status, dependencies and uncertainty"))
  (node moira process (label "Moira deliberation and gate disposition") (in owner-services)
    (attr authority "bounded deliberation and governed decisions"))
  (node daimon process (label "Daimon execution evidence") (in owner-services)
    (attr authority "agent session execution and recovery"))
  (node hermes store (label "Hermes ordered domain events") (in owner-services)
    (attr authority "append, replay, gaps and cursors"))
  (node pantheon process (label "Pantheon behavior and presentation facade") (in composition)
    (attr authority "compose, orient and route without semantic ownership"))
  (node operator actor (label "Human operator or accountable sponsor") (in human-authority)
    (attr authority "contestable judgment and final go or no-go"))
  (edge method-load data rune dendrite (label "Validate, load and retain exact digest")
    (attr evidence "scry and Dendrite provenance"))
  (edge definition-registration control rune definition-owner (label "Register exact review definition")
    (attr status "blocked until an owner is selected"))
  (edge tellus-source data dendrite tellus (label "Project bounded expertise and provenance")
    (attr constraint "Dendrite retains corpus and query truth"))
  (edge tellus-projection data tellus pantheon (label "Compose typed grounded-context presentation")
    (attr constraint "grounding is not operational truth"))
  (edge definition-projection data definition-owner pantheon (label "Project review lifecycle and exact revision")
    (attr constraint "Pantheon must not invent this state"))
  (edge artifact-projection data vellum pantheon (label "Project editable review artifacts")
    (attr constraint "document state is not approval"))
  (edge work-projection data chronos pantheon (label "Project work, status and operator attention")
    (attr constraint "appearance grants no authority"))
  (edge decision-projection data moira pantheon (label "Project decisions, dissent and pending gates")
    (attr constraint "retain exact instance and revision"))
  (edge execution-projection data daimon pantheon (label "Project session and recovery evidence")
    (attr constraint "provider prose is not a receipt"))
  (edge event-projection data hermes pantheon (label "Project ordered domain event cursors")
    (attr constraint "events are not logs, metrics, traces or approval"))
  (edge human-action control operator pantheon (label "Invoke one discoverable behavior")
    (attr route "key, mouse, palette, headless or API"))
  (edge work-command control pantheon chronos (label "Route owner-native work command")
    (attr constraint "expected revision and one attempt"))
  (edge gate-command control pantheon moira (label "Route named-human gate decision")
    (attr constraint "identity and authority remain owner verified"))
  (edge definition-command control pantheon definition-owner (label "Route definition lifecycle request")
    (attr status "unavailable until owner selection")))
